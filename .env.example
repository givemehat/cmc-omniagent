# CoinMarketCap API Configuration
# Get your free key at: https://coinmarketcap.com/api/
CMC_API_KEY=your_coinmarketcap_api_key_here

# Environment Mode: 'production' or 'sandbox'
# In sandbox mode, realistic live market snapshots are served if no key is provided.
CMC_ENVIRONMENT=production

# Server Configuration
PORT=8000
HOST=0.0.0.0
